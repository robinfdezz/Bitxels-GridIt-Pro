<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="9.0" ExtensionBundleId="com.antigravity.gridit" ExtensionBundleVersion="0.2.0"
    ExtensionBundleName="BitGrid Pro - Generador de Mallas y Guías para Logotipos"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.antigravity.gridit.panel" Version="0.1.5" />
    </ExtensionList>

    <ExecutionEnvironment>
        <HostList>
            <!-- Adobe Illustrator (ILST): Soporte completo para CC 2022 a CC 2026+ -->
            <Host Name="ILST" Version="[26.0,99.9]" />
        </HostList>
        <LocaleList>
            <Locale Code="All" />
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="9.0" />
        </RequiredRuntimeList>
    </ExecutionEnvironment>

    <DispatchInfoList>
        <Extension Id="com.antigravity.gridit.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./jsx/hostScript.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                        <Parameter>--mixed-content-allowed</Parameter>
                        <Parameter>--allow-file-access-from-files</Parameter>
                        <Parameter>--allow-file-access</Parameter>
                        <Parameter>--disable-web-security</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>BitGrid Pro</Menu>
                    <Geometry>
                        <Size>
                            <Height>580</Height>
                            <Width>320</Width>
                        </Size>
                        <MinSize>
                            <Height>420</Height>
                            <Width>280</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>1100</Height>
                            <Width>520</Width>
                        </MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>